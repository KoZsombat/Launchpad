# Apex domain used for app subdomains. The panel is served at panel.<BASE_DOMAIN>.
BASE_DOMAIN=example.com

# The single admin account. It is created on first start if no user exists.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-long-password

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-32-plus-character-secret

# Public URL of the panel. Must match the Cloudflare Access hostname.
BETTER_AUTH_URL=https://panel.example.com

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-a-random-32-plus-character-key

# Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels).
TUNNEL_TOKEN=replace-with-your-tunnel-token

# Optional: host path behind the panel's /data volume. App terminals start in
# <HOST_DATA_DIR>/repos/<app id> and uploads default there. Auto-detected from the
# panel container's Docker mount when unset.
# HOST_DATA_DIR=/opt/launchpad/data
